<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (c) Mica Technologies. Licensed under the GNU GPL v3.

  Strings for the Burn theme (WiX v5 thmutil), ported from the Java bundle's theme.wxl, plus
  the ids v5's WixStdBA added (Loading page, update button, cache/modify headers, the v5
  files-in-use prompt). [WixBundleName] and [WixBundleVersion] come from bundle.wxs.
-->
<WixLocalization Culture="en-us" Language="1033" xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <String Id="Caption" Value="[WixBundleName] Setup" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Checking for updates" />
  <String Id="UpdateButton" Value="&amp;Update to version [WixStdBAUpdateAvailable]" />

  <String Id="InstallHeader" Value="Welcome" />
  <String Id="InstallMessage" Value="Setup will install [WixBundleName] on your PC. By default the launcher installs for just you, under your user profile, so no administrator password is required.&#x0A;&#x0A;Click Install to continue, or Close to exit." />
  <String Id="InstallMessageOptions" Value="Setup will install [WixBundleName] on your PC. By default the launcher installs for just you, under your user profile, so no administrator password is required.&#x0A;&#x0A;Click Install to continue, or Close to exit." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="InstallForAllUsersCheckbox" Value="Install for &amp;all users on this PC (requires administrator)" />
  <String Id="InstallLicenseLinkText" Value="By installing you agree to the &lt;a href=&quot;#&quot;&gt;GNU GPL v3 license terms&lt;/a&gt;." />
  <String Id="InstallAcceptCheckbox" Value="I &amp;accept the license terms" />
  <String Id="InstallOptionsButton" Value="&amp;Options" />
  <String Id="InstallInstallButton" Value="&amp;Install" />
  <String Id="InstallCloseButton" Value="&amp;Close" />
  <String Id="InstallCancelButton" Value="&amp;Close" />

  <String Id="ConfirmCancelMessage" Value="Cancel and exit Setup?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Updating from previous version" />

  <String Id="HelpHeader" Value="[WixBundleName] Setup &#x2014; Help" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory]&#x0A;   Installs, repairs, uninstalls, or creates a complete local copy of the bundle in directory. Install is the default.&#x0A;&#x0A;/passive | /quiet&#x0A;   Displays minimal UI with no prompts, or no UI and no prompts. By default UI and all prompts are displayed.&#x0A;&#x0A;/norestart   Suppress any attempts to restart. By default UI will prompt before restart.&#x0A;/log log.txt Log to a specific file. By default a log file is created in %TEMP%.&#x0A;&#x0A;MMCL_INSTALL_FOR_ALL_USERS=1&#x0A;   Pick the per-machine MSI without checking the on-screen checkbox.&#x0A;   Useful for scripted deployments. 0 (default) selects the per-user MSI." />
  <String Id="HelpCloseButton" Value="&amp;Close" />

  <!-- Options page strings: the page is suppressed, but the BA may still look them up. -->
  <String Id="OptionsHeader" Value="Setup Options" />
  <String Id="OptionsLocationLabel" Value="Install location:" />
  <String Id="OptionsBrowseButton" Value="&amp;Browse" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="&amp;Back" />

  <String Id="ProgressHeader" Value="Installing [WixBundleName]" />
  <String Id="ProgressLabel" Value="Processing:" />
  <String Id="OverallProgressPackageText" Value="Initializing&#x2026;" />
  <String Id="ProgressCancelButton" Value="&amp;Cancel" />

  <String Id="ModifyHeader" Value="Modify [WixBundleName]" />
  <String Id="ModifyRepairButton" Value="&amp;Repair" />
  <String Id="ModifyUninstallButton" Value="&amp;Uninstall" />
  <String Id="ModifyCloseButton" Value="&amp;Close" />
  <String Id="ModifyCancelButton" Value="&amp;Close" />

  <String Id="SuccessHeader" Value="Setup Successful" />
  <String Id="SuccessCacheHeader" Value="Cache Successfully Completed" />
  <String Id="SuccessInstallHeader" Value="Installation Complete" />
  <String Id="SuccessLayoutHeader" Value="Layout Complete" />
  <String Id="SuccessModifyHeader" Value="Modify Complete" />
  <String Id="SuccessRepairHeader" Value="Repair Complete" />
  <String Id="SuccessUninstallHeader" Value="Uninstall Complete" />
  <String Id="SuccessUnsafeUninstallHeader" Value="Uninstall Complete" />
  <String Id="SuccessLaunchButton" Value="&amp;Launch" />
  <String Id="SuccessRestartText" Value="Restart your PC to finish." />
  <String Id="SuccessUninstallRestartText" Value="Restart your PC to finish removing the software." />
  <String Id="SuccessRestartButton" Value="&amp;Restart" />
  <String Id="SuccessCloseButton" Value="&amp;Close" />

  <String Id="FailureHeader" Value="Setup Failed" />
  <String Id="FailureCacheHeader" Value="Cache Failed" />
  <String Id="FailureInstallHeader" Value="Installation Failed" />
  <String Id="FailureLayoutHeader" Value="Layout Failed" />
  <String Id="FailureModifyHeader" Value="Modify Failed" />
  <String Id="FailureRepairHeader" Value="Repair Failed" />
  <String Id="FailureUninstallHeader" Value="Uninstall Failed" />
  <String Id="FailureUnsafeUninstallHeader" Value="Uninstall Failed" />
  <String Id="FailureHyperlinkLogText" Value="Setup hit an error. For details, open the &lt;a href=&quot;#&quot;&gt;log file&lt;/a&gt; or retry." />
  <String Id="FailureRestartText" Value="Restart your PC to finish rolling back." />
  <String Id="FailureRestartButton" Value="&amp;Restart" />
  <String Id="FailureCloseButton" Value="&amp;Close" />

  <String Id="FilesInUseTitle" Value="Files In Use" />
  <String Id="FilesInUseLabel" Value="[WixBundleName] is currently running. Close it before continuing:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Close the &amp;applications." />
  <String Id="FilesInUseCloseRadioButton" Value="Close the &amp;applications and continue." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Skip; a reboot will be required." />
  <String Id="FilesInUseRetryButton" Value="&amp;Retry" />
  <String Id="FilesInUseIgnoreButton" Value="&amp;Ignore" />
  <String Id="FilesInUseExitButton" Value="E&amp;xit" />
</WixLocalization>
