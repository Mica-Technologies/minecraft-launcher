<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (c) Mica Technologies. Licensed under the GNU GPL v3.

  Shortcut prompt page, ported from the Java installer's ShortcutPromptDlg.wxs (itself
  jpackage's dialog). The two check boxes sit at Y=100 and Y=140 so the stack reads centred in
  the 44..234 body. Both properties default to 1 in product.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="!(loc.ShortcutPromptDlg_Title)" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.ShortcutPromptDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.ShortcutPromptDlgTitle)" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="InstallDesktopShortcut" Type="CheckBox" X="20" Y="100" Width="300" Height="17"
                 CheckBoxValue="1" Property="JP_INSTALL_DESKTOP_SHORTCUT"
                 Text="!(loc.ShortcutPromptDlgDesktopShortcutControlLabel)" />
        <Control Id="InstallStartMenuShortcut" Type="CheckBox" X="20" Y="140" Width="300" Height="17"
                 CheckBoxValue="1" Property="JP_INSTALL_STARTMENU_SHORTCUT"
                 Text="!(loc.ShortcutPromptDlgStartMenuShortcutControlLabel)" />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
