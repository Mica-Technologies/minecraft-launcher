<!-- The sign-in card itself (information column + framed Microsoft page) is built in code
     by SignInPanel, shared with the "Add account" window, and placed in signInHost by
     MCLauncherLoginGui.setup().

     maxHeight/maxWidth are intentionally NOT pinned to the pref size: letting the rootPane
     fill the scene keeps the centered card on the window's real center rather than the
     center of a pinned 1000 px pane. -->
<GridPane fx:id="rootPane" minHeight="760.0" minWidth="900.0" prefHeight="860.0" prefWidth="1120.0" styleClass="rootPane hero-surface" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints fx:id="announcementRow" maxHeight="-Infinity" minHeight="0.0" />
        <RowConstraints vgrow="ALWAYS" />
    </rowConstraints>

    <!-- Announcement banner -->
    <Label fx:id="announcement" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" styleClass="banner-announcement" text="--" wrapText="true" />

    <StackPane fx:id="signInHost" GridPane.rowIndex="1">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="28.0" />
        </padding>
    </StackPane>
</GridPane>
