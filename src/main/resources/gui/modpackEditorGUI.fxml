<GridPane fx:id="rootPane" minHeight="475.0" minWidth="750.0"
          prefHeight="800.0" prefWidth="1000.0" styleClass="rootPane"
          xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>
    <rowConstraints>
        <!-- Row 0: top navbar (brand + title + help), ~52 px to match mainGUI -->
        <RowConstraints maxHeight="52.0" minHeight="52.0" prefHeight="52.0"/>
        <!-- Row 1: announcement banner (conditional, 0-60 px) — below the navbar -->
        <RowConstraints fx:id="announcementRow" maxHeight="-Infinity" minHeight="0.0"/>
        <!-- Row 2: file/document toolbar (New / Open / Validate / Diff) -->
        <RowConstraints maxHeight="44.0" minHeight="44.0" prefHeight="44.0"/>
        <!-- Row 3: TabPane fills remaining space -->
        <RowConstraints vgrow="ALWAYS"/>
        <!-- Row 4: bottom action bar (status + Save + Return), ~44 px -->
        <RowConstraints maxHeight="44.0" minHeight="44.0" prefHeight="44.0"/>
    </rowConstraints>

    <!-- Row 1: Announcement (below the navbar) -->
    <Label fx:id="announcement" alignment="CENTER" maxHeight="1.7976931348623157E308"
           maxWidth="1.7976931348623157E308" minHeight="0.0" styleClass="banner-announcement"
           text="--" wrapText="true" GridPane.rowIndex="1">
        <graphic><SVGPath styleClass="bannerIcon"><content><LauncherIcons fx:constant="ANNOUNCEMENT"/></content></SVGPath></graphic>
    </Label>

    <!-- Row 0: Top navbar — matches mainGUI / library / settings so the editor
         reads as part of the same app shell. Brand lockup on the left, screen
         title alongside, help button on the right. File-operation tools live
         in the sub-toolbar below; document state (Save/Return) lives in the
         bottom action bar. -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="navBar">
        <padding><Insets left="14.0" right="10.0"/></padding>

        <Pane prefWidth="36.0" prefHeight="36.0" minWidth="36.0" minHeight="36.0"
              maxWidth="36.0" maxHeight="36.0" styleClass="navBrandLogo">
            <fx:include source="components/micaBrandLogo-small.fxml"/>
        </Pane>
        <Label text="%editor.navbar.title" styleClass="navBrand"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Label fx:id="offlineLabel" text="%main.fetchLabel.offline" managed="false" visible="false"
               styleClass="chip-offline"/>
        <Label fx:id="helpBtn" styleClass="helpButton" accessibleText="%menu.help.title">
            <graphic><SVGPath styleClass="helpButtonGlyph"><content><LauncherIcons fx:constant="HELP"/></content></SVGPath></graphic>
        </Label>
    </HBox>

    <!-- Row 2: File / document tools. These are contextual to the editor
         (load a manifest, validate it, diff against a reference) so they live
         immediately below the navbar instead of cluttering it. -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="stripPane" GridPane.rowIndex="2">
        <padding>
            <Insets bottom="6.0" left="16.0" right="16.0" top="6.0"/>
        </padding>
        <MFXButton fx:id="newBtn" prefHeight="28.0" text="%editor.toolbar.new"/>
        <MFXButton fx:id="openFileBtn" prefHeight="28.0" text="%editor.toolbar.openFile"/>
        <MFXButton fx:id="openUrlBtn" prefHeight="28.0" text="%editor.toolbar.openUrl"/>
        <Pane HBox.hgrow="SOMETIMES" minWidth="16.0"/>
        <MFXButton fx:id="validateBtn" prefHeight="28.0" text="%editor.toolbar.validate"/>
        <MFXButton fx:id="diffBtn" prefHeight="28.0" text="%editor.toolbar.diff"/>
    </HBox>

    <!-- Row 3: TabPane -->
    <TabPane fx:id="editorTabPane" tabClosingPolicy="UNAVAILABLE" GridPane.rowIndex="3">
        <Tab text="%editor.tab.metadata" closable="false">
            <ScrollPane fitToWidth="true" styleClass="transparentBg">
                <VBox fx:id="metadataVBox" spacing="8.0" styleClass="transparentBg">
                    <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="16.0"/>
                    </padding>

                    <!-- Each section is a titled tile, like the Settings screen's groups. -->
                    <Label text="%editor.section.packIdentity" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsRow, tileOnly" spacing="12.0">
                        <MFXTextField fx:id="packNameField" floatingText="%editor.field.packName" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <MFXTextField fx:id="packVersionField" floatingText="%editor.field.packVersion" maxWidth="300.0"
                                          prefWidth="300.0" minHeight="48.0" prefHeight="48.0"/>
                            <!-- Version bumps: a connected button group. -->
                            <HBox styleClass="connectedGroup" spacing="2.0">
                                <MFXButton fx:id="bumpMajorBtn" text="%editor.bumpBtn.major" styleClass="tileFirst"/>
                                <MFXButton fx:id="bumpMinorBtn" text="%editor.bumpBtn.minor" styleClass="tileMiddle"/>
                                <MFXButton fx:id="bumpPatchBtn" text="%editor.bumpBtn.patch" styleClass="tileLast"/>
                            </HBox>
                        </HBox>
                        <MFXTextField fx:id="packURLField" floatingText="%editor.field.packUrl" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                        <MFXTextField fx:id="packMinRAMField" floatingText="%editor.field.minRam" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                    </VBox>

                    <Label text="%editor.section.flags" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsRow, tileOnly" spacing="8.0">
                        <MFXToggleButton fx:id="packUnstableToggle" text="%editor.toggle.unstable"/>
                        <MFXToggleButton fx:id="packCustomDiscordRpcToggle" text="%editor.toggle.customDiscordRpc"/>
                    </VBox>

                    <Label text="%editor.section.modloader" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsRow, tileOnly" spacing="12.0">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <MFXComboBox fx:id="packModLoaderTypeCombo" prefWidth="160.0" minHeight="32.0"/>
                            <MFXButton fx:id="forgePickerBtn" text="%editor.pickerBtn.forge" prefHeight="28.0"/>
                        </HBox>
                        <Label fx:id="packModLoaderHint" styleClass="settingsHint" wrapText="true"
                               text="%editor.modloaderHint"/>
                        <MFXTextField fx:id="packForgeURLField" floatingText="%editor.field.modloaderUrl" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                        <MFXTextField fx:id="packForgeHashField" floatingText="%editor.field.modloaderSha1" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                        <MFXTextField fx:id="packMinecraftVersionField" floatingText="%editor.field.minecraftVersion" maxWidth="500.0"
                                      prefWidth="500.0" minHeight="48.0" prefHeight="48.0"/>
                    </VBox>

                    <Label text="%editor.section.images" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsRow, tileOnly" spacing="16.0">
                        <HBox spacing="16.0" alignment="CENTER_LEFT">
                            <VBox spacing="4.0">
                                <TextArea fx:id="packLogoURLField" maxWidth="400.0" prefWidth="400.0"
                                          prefHeight="58.0" wrapText="false"
                                          promptText="%editor.logoUrls.prompt"/>
                                <MFXTextField fx:id="packLogoSha1Field" floatingText="%editor.field.logoSha1" maxWidth="400.0"
                                              prefWidth="400.0" minHeight="48.0" prefHeight="48.0"/>
                            </VBox>
                            <ImageView fx:id="logoPreview" fitHeight="64.0" fitWidth="64.0" preserveRatio="true"
                                       accessibleText="%editor.preview.logo"/>
                        </HBox>
                        <HBox spacing="16.0" alignment="CENTER_LEFT">
                            <VBox spacing="4.0">
                                <TextArea fx:id="packBgURLField" maxWidth="400.0" prefWidth="400.0"
                                          prefHeight="58.0" wrapText="false"
                                          promptText="%editor.backgroundUrls.prompt"/>
                                <MFXTextField fx:id="packBgSha1Field" floatingText="%editor.field.backgroundSha1" maxWidth="400.0"
                                              prefWidth="400.0" minHeight="48.0" prefHeight="48.0"/>
                            </VBox>
                            <ImageView fx:id="bgPreview" fitHeight="64.0" fitWidth="128.0" preserveRatio="true"
                                       accessibleText="%editor.preview.background"/>
                        </HBox>
                    </VBox>

                    <Label text="%editor.section.scanExclusions" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsRow, tileOnly">
                        <TextArea fx:id="scanExclusionsArea" prefHeight="80.0" maxWidth="500.0" prefWidth="500.0"
                                  promptText="%editor.filePath.prompt"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>

    <!-- Row 4: Bottom action bar — status text + Save/Return. Mirrors the
         Settings screen's bottom-bar pattern (primary actions right-aligned,
         contextual info on the left). -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="bottomBar" GridPane.rowIndex="4">
        <padding><Insets left="14.0" right="14.0"/></padding>
        <Label fx:id="statusLabel" text="%editor.status.noFile" styleClass="muted"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <MFXButton minWidth="-Infinity" fx:id="saveBtn" prefHeight="28.0" text="%editor.saveBtn"/>
        <MFXButton minWidth="-Infinity" fx:id="returnBtn" prefHeight="28.0" text="%editor.returnBtn"/>
    </HBox>
</GridPane>
