<GridPane fx:id="rootPane" minHeight="475.0" minWidth="750.0"
          prefHeight="800.0" prefWidth="1000.0" styleClass="rootPane hero-surface"
          xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Backdrop: a soft glow in the theme's hue behind the card, and a strip of blocky
         Minecraft hills along the bottom (BlockyHorizon). Both are decoration and
         ignore the mouse. -->
    <Region styleClass="progressGlow" mouseTransparent="true"
            maxWidth="Infinity" maxHeight="Infinity" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"/>
    <BlockyHorizon maxWidth="Infinity" GridPane.valignment="BOTTOM"/>

    <!-- The card. Sizes to its content: the cancel row is managed in only when a caller
         offers cancellation (setCancelHandler), and the speed chip only while it has text. -->
    <VBox styleClass="progressCard" alignment="CENTER" spacing="10.0"
          maxWidth="480.0" minWidth="400.0" prefWidth="460.0" maxHeight="-Infinity"
          GridPane.halignment="CENTER" GridPane.valignment="CENTER">
        <padding><Insets top="32.0" bottom="28.0" left="32.0" right="32.0"/></padding>

        <!-- Minecraft blocks (dirt / grass / stone) drawn as iso SVG faces. MCLauncherProgressGui
             makes them hop in a staggered wave; each one's shadow shrinks as it rises. -->
        <HBox alignment="BOTTOM_CENTER" spacing="14.0">
            <padding><Insets bottom="8.0"/></padding>
            <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                <Group fx:id="voxelCube1">
                    <SVGPath fill="#8B6A3F" content="M 18 0 L 36 9 L 18 18 L 0 9 Z"/>
                    <SVGPath fill="#5C4322" content="M 0 9 L 18 18 L 18 36 L 0 27 Z"/>
                    <SVGPath fill="#3F2E14" content="M 36 9 L 18 18 L 18 36 L 36 27 Z"/>
                </Group>
                <Ellipse fx:id="voxelShadow1" radiusX="15.0" radiusY="3.0" styleClass="voxelShadow"/>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                <Group fx:id="voxelCube2">
                    <SVGPath fill="#6FCF3D" content="M 18 0 L 36 9 L 18 18 L 0 9 Z"/>
                    <SVGPath fill="#3C8527" content="M 0 9 L 18 18 L 18 36 L 0 27 Z"/>
                    <SVGPath fill="#2A6B1E" content="M 36 9 L 18 18 L 18 36 L 36 27 Z"/>
                </Group>
                <Ellipse fx:id="voxelShadow2" radiusX="15.0" radiusY="3.0" styleClass="voxelShadow"/>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" spacing="6.0">
                <Group fx:id="voxelCube3">
                    <SVGPath fill="#A8AEB8" content="M 18 0 L 36 9 L 18 18 L 0 9 Z"/>
                    <SVGPath fill="#6B7280" content="M 0 9 L 18 18 L 18 36 L 0 27 Z"/>
                    <SVGPath fill="#4B5563" content="M 36 9 L 18 18 L 18 36 L 36 27 Z"/>
                </Group>
                <Ellipse fx:id="voxelShadow3" radiusX="15.0" radiusY="3.0" styleClass="voxelShadow"/>
            </VBox>
        </HBox>

        <!-- Overall task title, e.g. "Installing All the Mods 9". -->
        <Label fx:id="upperLabel" alignment="CENTER" textAlignment="CENTER" wrapText="true"
               maxWidth="400.0" styleClass="progressTitle" text="%progress.title.justAMoment"/>

        <!-- Current step, e.g. "Downloading mods". -->
        <Label fx:id="sectionLabel" alignment="CENTER" textAlignment="CENTER" wrapText="true"
               maxWidth="400.0" styleClass="progressStep" text=""/>

        <WavyProgressBar fx:id="progressBar" prefWidth="360.0" maxWidth="360.0">
            <VBox.margin><Insets top="6.0" bottom="2.0"/></VBox.margin>
        </WavyProgressBar>

        <!-- File-level detail, e.g. "Verified jna-4.4.0.jar". -->
        <Label fx:id="detailLabel" alignment="CENTER" textAlignment="CENTER" wrapText="true"
               maxWidth="400.0" styleClass="progressDetail" text=""/>

        <!-- Speed and time left, as a small chip; hidden while empty. -->
        <Label fx:id="speedLabel" styleClass="progressChip" text="" visible="false" managed="false"/>

        <!-- Cancel. Hidden and unmanaged unless a caller opts in (setCancelHandler). -->
        <HBox fx:id="cancelBtnRow" alignment="CENTER" visible="false" managed="false">
            <padding><Insets top="10.0"/></padding>
            <MFXButton fx:id="cancelBtn" text="%progress.cancelBtn.label" styleClass="tonalBtn"/>
        </HBox>
    </VBox>
</GridPane>
