<GridPane fx:id="rootPane" minHeight="475.0" minWidth="750.0" prefHeight="800.0" prefWidth="1000.0" styleClass="rootPane" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    </columnConstraints>
    <rowConstraints>
        <!-- Row 0: top navbar — matches main-menu + library pattern (~52 px) -->
        <RowConstraints maxHeight="52.0" minHeight="52.0" prefHeight="52.0" />
        <!-- Row 1: announcement banner (conditional 0/30 px) — sits below the navbar -->
        <RowConstraints fx:id="announcementRow" maxHeight="-Infinity" minHeight="0.0" />
        <!-- Row 2: sidebar + content -->
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <!-- Row 3: bottom bar (Save / Return), ~44 px -->
        <RowConstraints maxHeight="44.0" minHeight="44.0" prefHeight="44.0" />
    </rowConstraints>

    <!-- Row 1: Announcement banner (below the navbar) -->
    <Label fx:id="announcement" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" styleClass="banner-announcement" text="--" wrapText="true" GridPane.rowIndex="1" />

    <!-- Row 0: Top navbar — mirrors mainGUI / library navbars so the Settings screen
         reads as part of the same app shell rather than a one-off layout. Brand
         lockup on the left (matching main menu), screen title next to it, then the
         help button on the right. Save + Return stay on the bottom action bar so
         they're easy to reach without scrolling. -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="navBar">
        <padding><Insets left="14.0" right="10.0"/></padding>

        <Pane prefWidth="36.0" prefHeight="36.0" minWidth="36.0" minHeight="36.0"
              maxWidth="36.0" maxHeight="36.0" styleClass="navBrandLogo">
            <fx:include source="components/micaBrandLogo-small.fxml"/>
        </Pane>
        <Label text="%settings.fxml.settings" styleClass="navBrand"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Label fx:id="offlineLabel" text="%settings.fxml.offline" managed="false" visible="false"
               styleClass="chip-offline"/>
        <Label fx:id="helpBtn" text="?" styleClass="helpButton"/>
    </HBox>

    <!-- Row 2: Sidebar + Content -->
    <HBox GridPane.rowIndex="2" HBox.hgrow="ALWAYS">
        <!-- Left sidebar navigation, laid out like Android's settings list: related
             categories form a group of tiles (rounded at the group's outer corners,
             2 px apart), each tile an icon, a title and a summary. MCLauncherSettingsGui
             adds the icon and summary (SettingsNavTile). The scroll pane only scrolls
             when the window is too short for every tile. About stays pinned at the
             bottom: a destination users rarely visit. -->
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    minWidth="304.0" maxWidth="304.0" prefWidth="304.0" styleClass="transparentScroll, settingsNavScroll">
            <VBox styleClass="settingsNav" spacing="12" minHeight="-Infinity">
                <padding>
                    <Insets top="12.0" bottom="12.0" left="12.0" right="12.0" />
                </padding>
                <VBox styleClass="settingsNavGroup" spacing="2">
                    <MFXButton fx:id="navAccount" text="%settings.fxml.account" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                </VBox>
                <VBox styleClass="settingsNavGroup" spacing="2">
                    <MFXButton fx:id="navGame" text="%settings.fxml.game" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                    <MFXButton fx:id="navAppearance" text="%settings.fxml.appearance" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                    <MFXButton fx:id="navAdvanced" text="%settings.fxml.advanced" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                </VBox>
                <VBox styleClass="settingsNavGroup" spacing="2">
                    <MFXButton fx:id="navNetwork" text="%settings.fxml.network" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                    <MFXButton fx:id="navSecurity" text="%settings.fxml.security" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                    <MFXButton fx:id="navSystem" text="%settings.fxml.system" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                </VBox>
                <VBox styleClass="settingsNavGroup" spacing="2">
                    <MFXButton fx:id="navDiscord" text="%settings.fxml.discord" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                    <MFXButton fx:id="navRgb" text="%settings.fxml.rgb" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                </VBox>
                <Pane VBox.vgrow="ALWAYS" />
                <VBox styleClass="settingsNavGroup" spacing="2">
                    <MFXButton fx:id="navAbout" text="%settings.fxml.about" styleClass="settingsNavBtn" maxWidth="1.7976931348623157E308" />
                </VBox>
            </VBox>
        </ScrollPane>

        <!-- Right content area: stacked category panes -->
        <StackPane fx:id="settingsContent" HBox.hgrow="ALWAYS">

            <!-- Category 0: Account -->
            <ScrollPane fx:id="accountPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.account" styleClass="settingsCategoryHeader"/>
                    <!-- Player profile card -->
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <ImageView fx:id="accountAvatar" fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true" />
                                <VBox spacing="4">
                                    <Label fx:id="accountNameLabel" text="%settings.fxml.player" styleClass="type-title-medium"/>
                                    <Label fx:id="accountUuidLabel" text="%settings.fxml.uuid" wrapText="true" styleClass="settingsHint"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                    <!-- Helpful links -->
                    <Label text="%settings.fxml.helpfulLinks" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8">
                                <MFXButton fx:id="minecraftNetBtn" prefHeight="30.0" text="%settings.fxml.minecraftNet" styleClass="type-label-medium"/>
                                <MFXButton fx:id="msAccountBtn" prefHeight="30.0" text="%settings.fxml.microsoftAccount" styleClass="type-label-medium"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <!-- Saved Accounts — populated by setupAccountTab() from
                         the signed-in accounts. Rows are appended at runtime
                         to the savedAccountsList VBox; the FXML just declares
                         the container chrome. -->
                    <Label text="%settings.accounts.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.accounts.hint" wrapText="true" styleClass="settingsHint"/>
                            <VBox fx:id="savedAccountsList" spacing="6" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXButton fx:id="addAccountBtn" prefHeight="30.0" prefWidth="180.0" text="%settings.accounts.add" styleClass="type-label-medium"/>
                        </VBox>
                    </VBox>
                    <!-- Log out -->
                    <Label text="%settings.fxml.signOut" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup, dangerZone" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.accounts.signOutHint" wrapText="true" styleClass="settingsHint"/>
                            <MFXButton fx:id="logoutBtn" prefHeight="30.0" prefWidth="160.0" text="%settings.accounts.signOutDefault" styleClass="dangerZone, type-label-medium"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 1: Game -->
            <ScrollPane fx:id="gamePane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.game" styleClass="settingsCategoryHeader"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.minimumRamGb" />
                            <Spinner fx:id="minRamGb" editable="true" prefWidth="120.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.maximumRamGb" />
                            <Spinner fx:id="maxRamGb" editable="true" prefWidth="120.0" />
                            <Label fx:id="sysRamLabel" text="%settings.fxml.youHaveX" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.jvmPreset" />
                            <MFXComboBox fx:id="jvmPresetSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="250.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <MFXButton fx:id="generateJvmArgsBtn" text="%settings.fxml.generateJvmArgs" prefHeight="32.0" />
                                <Label fx:id="generateJvmArgsHint" text="" styleClass="muted, settingsHint" wrapText="true"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 1: Appearance -->
            <ScrollPane fx:id="appearancePane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.appearance" styleClass="settingsCategoryHeader"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.theme" />
                            <MFXComboBox fx:id="themeSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="250.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="wavyProgressToggle" text="%settings.appearance.wavyProgress" />
                            <Label text="%settings.appearance.wavyProgress.hint" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="reduceMotionToggle" text="%settings.appearance.reduceMotion" />
                            <Label text="%settings.appearance.reduceMotion.hint" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.language" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.defaultsToYour" wrapText="true" styleClass="settingsHint"/>
                            <MFXComboBox fx:id="languageSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="300.0" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.packImagery" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.whenOnModpack" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="showPackBackgroundsToggle" text="%settings.fxml.showPackBackground" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.imageCycleInterval" wrapText="true" styleClass="settingsHint"/>
                            <MFXComboBox fx:id="imageCycleIntervalSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="300.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="imageCycleShuffleToggle" text="%settings.fxml.imageCycleShuffle" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 2: Advanced -->
            <ScrollPane fx:id="advancedPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.advanced" styleClass="settingsCategoryHeader"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="debugCheckBox" text="%settings.fxml.debugMode" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="windowResizeCheckBox" text="%settings.fxml.windowResizing" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="enhancedLoggingCheckBox" text="%settings.fxml.enhancedLogging" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="inGameConsoleCheckBox" text="%settings.runningGames.keepOpen" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="%settings.fxml.consoleLogMaxLines" />
                                <MFXComboBox fx:id="consoleLogMaxLinesSelection" prefWidth="140.0" />
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="batteryThrottleCheckBox" text="%settings.fxml.throttleDownloadsOn" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="lwjglArmPatchCheckBox" text="%settings.fxml.lwjglArm64Patching" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.replacesX86_64Lwjgl2" wrapText="true"/>
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.securityScanFrequency" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.howOftenThe" wrapText="true" styleClass="settingsHint"/>
                            <MFXComboBox fx:id="defaultScanFrequencyCombo" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="280.0" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.backupHeader" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.backupBlurb" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="autoBackupToggle" text="%settings.fxml.autoBackupBeforeUpdate" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="backupIncludeSavesToggle" text="%settings.fxml.backupIncludeSaves" />
                            <Label text="%settings.fxml.backupIncludeSavesHint" wrapText="true" styleClass="muted, settingsHint"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="%settings.fxml.backupMaxCount" />
                                <Spinner fx:id="backupMaxCountSpinner" editable="true" prefWidth="80.0" />
                                <Label text="%settings.fxml.backupMaxAgeDays" />
                                <Spinner fx:id="backupMaxAgeDaysSpinner" editable="true" prefWidth="80.0" />
                            </HBox>
                            <Label text="%settings.fxml.backupCountAgeHint" wrapText="true" styleClass="muted, settingsHint"/>
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.gameFileIntegrity" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.reHashesEvery" wrapText="true" styleClass="settingsHint"/>
                            <HBox spacing="8">
                                <MFXButton fx:id="verifyAllGameFilesBtn" prefHeight="30.0" prefWidth="180.0" text="%settings.fxml.verifyAllGame" styleClass="type-label-medium"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.thirdPartyIntegrations" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.curseforgeCoreApi" wrapText="true" styleClass="settingsHint"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <MFXPasswordField fx:id="curseForgeApiKeyField" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="320.0" floatingText="CurseForge API key" />
                                <MFXButton fx:id="curseForgeApiKeySaveBtn" prefHeight="30.0" prefWidth="80.0" text="%settings.fxml.save" styleClass="type-label-medium"/>
                                <MFXButton fx:id="curseForgeApiKeyClearBtn" prefHeight="30.0" prefWidth="80.0" text="%settings.fxml.clear" styleClass="type-label-medium"/>
                            </HBox>
                            <Label fx:id="curseForgeApiKeyStatusLabel" styleClass="muted, settingsHint"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 3: Network -->
            <ScrollPane fx:id="networkPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.network" styleClass="settingsCategoryHeader"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="proxyEnableCheckBox" text="%settings.fxml.enableProxy" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.proxyType" />
                            <MFXComboBox fx:id="proxyTypeSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="120.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.proxyHost" />
                            <TextField fx:id="proxyHostField" promptText="%settings.proxyHost.prompt" prefWidth="250.0" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.proxyPort" />
                            <Spinner fx:id="proxyPortSpinner" editable="true" prefWidth="120.0" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 4: Security -->
            <ScrollPane fx:id="securityPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.security" styleClass="settingsCategoryHeader"/>
                    <Label text="%settings.fxml.malwareScanning" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label fx:id="scanFolderLabel" text="%settings.fxml.scanFolderPath" wrapText="true" styleClass="settingsHint"/>
                            <HBox spacing="8">
                                <MFXButton fx:id="scanBtn" prefHeight="30.0" text="%settings.fxml.scan" styleClass="type-label-medium"/>
                                <MFXButton fx:id="scanFolderBtn" prefHeight="30.0" text="%settings.fxml.changeFolder" styleClass="type-label-medium"/>
                                <MFXProgressBar fx:id="scanProgressBar" />
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label fx:id="scanOutputLabel" text="%settings.fxml.scanOutput" wrapText="true" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.deepLinksMmcl" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.whenEnabledQuot" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="uriHandlerToggle" text="%settings.fxml.allowMmclDeep" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.mcp.section.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.mcp.enable.description" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="mcpServerToggle" text="%settings.mcp.enable.label" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.mcp.autoApproveReadOnly.description" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="mcpAutoApproveToggle" text="%settings.mcp.autoApproveReadOnly.label" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.mcp.allowStateChanges.description" wrapText="true" styleClass="settingsHint"/>
                            <MFXToggleButton fx:id="mcpAllowStateChangesToggle" text="%settings.mcp.allowStateChanges.label" />
                            <Label fx:id="mcpStatusLabel" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>
                    <Label text="%settings.mcp.connect.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.mcp.connect.description" wrapText="true" styleClass="settingsHint"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="%settings.mcp.connect.endpoint" minWidth="70.0" />
                                <Label fx:id="mcpEndpointLabel" wrapText="true" />
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="%settings.mcp.connect.token" minWidth="70.0" />
                                <Label fx:id="mcpTokenLabel" wrapText="true" />
                                <MFXButton fx:id="mcpRevealTokenBtn" text="%settings.mcp.connect.token.reveal" />
                                <MFXButton fx:id="mcpCopyTokenBtn" text="%settings.mcp.connect.token.copy" />
                                <MFXButton fx:id="mcpRegenTokenBtn" text="%settings.mcp.connect.token.regenerate" />
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <MFXComboBox fx:id="mcpClientSelection" />
                                <MFXButton fx:id="mcpCopySetupBtn" text="%settings.mcp.connect.copy" />
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <TextArea fx:id="mcpSetupSnippet" editable="false" wrapText="false"
                                      prefRowCount="7" styleClass="settingsTextArea" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.mcp.permissions.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.mcp.permissions.description" wrapText="true" styleClass="settingsHint"/>
                            <VBox fx:id="mcpToolPolicyList" spacing="6" fillWidth="true" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.mcp.sessions.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <VBox fx:id="mcpSessionList" spacing="4" fillWidth="true" />
                        </VBox>
                    </VBox>
                    <Label text="%settings.mcp.activity.title" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <VBox fx:id="mcpActivityList" spacing="4" fillWidth="true" />
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8">
                                <MFXButton fx:id="mcpRefreshBtn" text="%settings.mcp.refresh.label" />
                                <MFXButton fx:id="mcpClearActivityBtn" text="%settings.mcp.activity.clear" />
                            </HBox>
                            <Label text="%settings.mcp.revokeGrants.description" wrapText="true" styleClass="settingsHint"/>
                            <Label fx:id="mcpGrantsLabel" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXButton fx:id="mcpRevokeGrantsBtn" text="%settings.mcp.revokeGrants.label" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 5: System -->
            <ScrollPane fx:id="systemPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.system" styleClass="settingsCategoryHeader"/>
                    <Label text="%settings.fxml.resetAmpRuntime" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8">
                                <MFXButton fx:id="resetLauncherBtn" prefHeight="30.0" prefWidth="120.0" text="%settings.fxml.resetLauncher" styleClass="type-label-medium"/>
                                <MFXButton fx:id="resetRuntimeBtn" prefHeight="30.0" prefWidth="120.0" text="%settings.fxml.resetRuntimes" styleClass="type-label-medium"/>
                            </HBox>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXButton fx:id="manageRuntimeBtn" prefHeight="30.0" prefWidth="140.0" text="%settings.fxml.manageRuntimes" styleClass="type-label-medium"/>
                        </VBox>
                    </VBox>
                    <Label text="%settings.fxml.importExport" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8">
                                <MFXButton fx:id="exportSettingsBtn" prefHeight="30.0" prefWidth="120.0" text="%settings.fxml.exportSettings" styleClass="type-label-medium"/>
                                <MFXButton fx:id="importSettingsBtn" prefHeight="30.0" prefWidth="120.0" text="%settings.fxml.importSettings" styleClass="type-label-medium"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXButton fx:id="openFolderBtn" prefHeight="28.0" prefWidth="180.0" text="%settings.fxml.openLauncherFolder" />
                            <Label fx:id="versionLabel" text="%settings.fxml.launcherVersionErr_unk" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 7: Discord -->
            <ScrollPane fx:id="discordPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.discord" styleClass="settingsCategoryHeader"/>

                    <!-- Rich presence toggle (moved here from Advanced for grouping). -->
                    <Label text="%settings.fxml.richPresence" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="discordCheckBox" text="%settings.fxml.discordIntegration" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.showWhatYou" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- "Join Game" invite toggle — Discord-specific party + joinSecret on
                         the in-game presence so friends see a "Join Game" button. -->
                    <Label text="%settings.fxml.friendInvites" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="discordInvitesCheckBox" text="%settings.fxml.allowDiscordInvites" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.whenEnabledFriends" wrapText="true"/>
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.youCanAlso" wrapText="true"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 8: RGB Integration -->
            <ScrollPane fx:id="rgbPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.rgbLighting" styleClass="settingsCategoryHeader"/>

                    <!-- Master enable + backend choice + live status. -->
                    <Label text="%settings.fxml.lightingBackend" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="rgbEnableToggle" text="%settings.fxml.enableRgbLighting" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.whenEnabledThe" wrapText="true"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="%settings.fxml.backend" />
                                <MFXComboBox fx:id="rgbBackendCombo" prefWidth="200.0" />
                                <Label fx:id="rgbStatusChip" text="%settings.fxml.disabled" styleClass="stat-chip" />
                            </HBox>
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.autoRunsEvery" wrapText="true"/>
                            <Label fx:id="rgbAutoToggleHeader" text="%settings.fxml.autoModeIntegrations" styleClass="muted, settingsHint"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <VBox fx:id="rgbAutoToggleBox" spacing="4">
                                <MFXToggleButton fx:id="rgbEnableOpenRgbToggle" text="%settings.fxml.openrgb" />
                                <MFXToggleButton fx:id="rgbEnableChromaNativeToggle" text="%settings.fxml.razerChromaNative" />
                                <MFXToggleButton fx:id="rgbEnableWindowsDlToggle" text="%settings.fxml.windowsDynamicLighting" />
                                <MFXToggleButton fx:id="rgbEnableCorsairToggle" text="%settings.fxml.corsairIcue" />
                                <MFXToggleButton fx:id="rgbEnableAsusAuraToggle" text="%settings.fxml.asusAuraLegacy" />
                                <MFXToggleButton fx:id="rgbEnableChromaRestToggle" text="%settings.fxml.razerChromaRest" />
                            </VBox>
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.turnOffThe" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- Idle/menu effect toggle + animation style picker. -->
                    <Label text="%settings.fxml.menuEffect" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="rgbMenuEffectToggle" text="%settings.fxml.lightUpDevices" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.whenOnYour" wrapText="true"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.animationStyle" styleClass="muted, settingsHint"/>
                            <MFXComboBox fx:id="rgbEffectStyleSelection" maxHeight="36.0" minHeight="36.0" prefHeight="36.0" prefWidth="220.0" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.solidSingleSteady" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- Effect behavior toggles. -->
                    <Label text="%settings.fxml.inGameEffects" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="rgbUsePackColorsToggle" text="%settings.fxml.useModpackColors" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.lightUpThe" wrapText="true"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <MFXToggleButton fx:id="rgbHighlightKeysToggle" text="%settings.fxml.highlightMinecraftKeys" />
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.overlayWasdE" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- Test button — flashes solid magenta on every connected device so the user
                         can confirm the backend is talking to their hardware. -->
                    <Label text="%settings.fxml.test" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.flashesSolidMagenta" wrapText="true"/>
                            <MFXButton fx:id="rgbTestBtn" prefHeight="30.0" prefWidth="160.0" text="%settings.fxml.testConnection" />
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Category 9: About / Attributions -->
            <ScrollPane fx:id="aboutPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="transparentScroll" visible="false" managed="false">
                <VBox spacing="12" fillWidth="true">
                    <padding>
                        <Insets top="16.0" bottom="16.0" left="16.0" right="16.0" />
                    </padding>
                    <Label text="%settings.fxml.about" styleClass="settingsCategoryHeader"/>

                    <!-- Launcher identity card -->
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label fx:id="aboutAppNameLabel" text="%settings.fxml.micaMinecraftLauncher" styleClass="type-title-medium"/>
                            <Label fx:id="aboutVersionLabel" text="%settings.fxml.version" wrapText="true" styleClass="settingsHint"/>
                            <Label text="© 2021–2026 Mica Technologies" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <!-- Update-check toggle. Lives in the launcher identity card
                                 since it's directly tied to the version info above —
                                 a user noticing they're on an old version naturally
                                 looks here for "how do I get updates." Default ON so
                                 new installs receive update prompts. -->
                            <MFXToggleButton fx:id="launcherUpdateCheckBox" text="%settings.fxml.checkForLauncher"/>
                            <Label styleClass="muted, settingsHint" text="%settings.fxml.whenOffThe" wrapText="true"/>
                        </VBox>
                        <VBox styleClass="settingsRow" spacing="6">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <MFXButton fx:id="aboutWebsiteBtn" prefHeight="28.0" prefWidth="140.0" text="%settings.fxml.visitWebsite" styleClass="type-label-medium"/>
                                <MFXButton fx:id="aboutSourceBtn" prefHeight="28.0" prefWidth="140.0" text="%settings.fxml.viewSource" styleClass="type-label-medium"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Trademark + non-affiliation notice -->
                    <Label text="%settings.fxml.minecraftTrademark" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.minecraftIsA" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>

                    <!-- Open-source acknowledgments -->
                    <Label text="%settings.fxml.openSourceAcknowledgments" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.theLauncherUses" wrapText="true" styleClass="settingsHint"/>
                            <Label text="• OpenJFX — GPLv2 with Classpath Exception&#10;• MaterialFX (palexdev) — LGPL 3.0&#10;• jthemedetecor (Dansoftowner) — Apache 2.0&#10;• FXTaskbarProgressBar (Dansoftowner) — Apache 2.0&#10;• oshi-core — MIT&#10;• JNA / JNA Platform — Apache 2.0 / LGPL 2.1&#10;• Google Gson — Apache 2.0&#10;• Apache Commons IO — Apache 2.0&#10;• Apache Commons Lang3 — Apache 2.0&#10;• SLF4J — MIT&#10;• jarchivelib — Apache 2.0&#10;• minecraft_authenticator — MIT&#10;• jarscanner — MIT" wrapText="true" styleClass="settingsHint"/>
                            <Label text="%settings.fxml.fullLicenseTexts" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>

                    <!-- Runtime dependencies — Java distributions pulled at run time,
                         distinct from the bundled libraries above. -->
                    <Label text="%settings.fxml.javaRuntimes" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.modernMinecraftVersions" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>

                    <!-- ARM64 native library credits — community-built binaries the
                         launcher downloads on demand when LWJGL ARM Patching is enabled. -->
                    <Label text="%settings.fxml.arm64NativeLibraries" styleClass="settingsSectionTitle"/>
                    <VBox styleClass="settingsGroup" spacing="2">
                        <VBox styleClass="settingsRow" spacing="6">
                            <Label text="%settings.fxml.whenLwjglArm" wrapText="true" styleClass="settingsHint"/>
                            <Label text="• MinecraftMachina/lwjgl — LWJGL2 ARM64 macOS natives (BSD)&#10;• r58Playz/jinput-m1 — jinput ARM64 macOS natives&#10;• theofficialgman/lwjgl3-binaries-arm64 — LWJGL2 / jinput ARM64 Linux natives" wrapText="true" styleClass="settingsHint"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>

        </StackPane>
    </HBox>

    <!-- Row 3: Bottom bar with Save + Return — right-aligned via a flex spacer
         to match the modpack editor / runtime / library / main-menu pattern. -->
    <HBox styleClass="bottomBar" alignment="CENTER_LEFT" spacing="10.0" minHeight="44.0" maxHeight="44.0" prefHeight="44.0" GridPane.rowIndex="3">
        <padding>
            <Insets left="14.0" right="14.0" />
        </padding>
        <Pane HBox.hgrow="ALWAYS"/>
        <MFXButton fx:id="saveBtn" prefHeight="28.0" prefWidth="80.0" text="%settings.fxml.save" />
        <!-- Only shown (visible + managed) while a language change is pending — a
             language switch needs a relaunch to fully re-apply (Locale.setDefault and
             the static translation fields are locked at launch), so this offers a
             save-and-relaunch shortcut inline next to Save. Toggled in
             MCLauncherSettingsGui via the language dropdown listener. -->
        <MFXButton fx:id="saveAndRestartBtn" prefHeight="28.0" prefWidth="140.0" text="%settings.fxml.saveAndRestart" visible="false" managed="false" />
        <MFXButton fx:id="returnBtn" prefHeight="28.0" prefWidth="80.0" text="%settings.fxml.return" />
    </HBox>
</GridPane>
