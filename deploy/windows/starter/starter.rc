/*
 * Resources for the native starter: the launcher icon (shortcuts, the taskbar, Explorer and the
 * installer's Add/Remove Programs entry all take it from this exe), version information, and the
 * manifest. starter_build.h is generated by build-starter.ps1.
 */

#include <winver.h>
#include <winuser.h>
#include "starter_build.h"

1 ICON MMCL_ICON_PATH

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "starter.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMCL_VERSION_BINARY
 PRODUCTVERSION MMCL_VERSION_BINARY
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mica Technologies"
            VALUE "FileDescription", MMCL_APP_NAME_A
            VALUE "FileVersion", MMCL_VERSION_STRING
            VALUE "InternalName", "starter"
            VALUE "LegalCopyright", "Copyright (c) 2026 Mica Technologies. GNU GPL v3."
            VALUE "OriginalFilename", MMCL_EXE_NAME_A
            VALUE "ProductName", MMCL_APP_NAME_A
            VALUE "ProductVersion", MMCL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
